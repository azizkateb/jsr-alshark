---
import {site, profiles, news, waLink, formatDate, icons, theme, layout, copy, animations, navItems} from '../lib/content';
import {assetUrl,webUrl,telLink} from '../lib/urls';
import '../styles/global.css';
import SiteSection from '../components/SiteSection.astro';
import {themeCss,themeFontUrl} from '../lib/content';
---

<!DOCTYPE html>

<html dir="rtl" lang="ar"><head>
<meta charset="utf-8"/><meta content="width=device-width, initial-scale=1" name="viewport"/><meta content={site.description} name="description"/><meta content={site.launchReady ? 'index,follow' : 'noindex,nofollow'} name="robots"/><title>{site.name}</title><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>{themeFontUrl && <link href={themeFontUrl} rel="stylesheet"/>}<style is:global set:html={themeCss}></style>{site.launchReady && Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>}<link data-about-font href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body dir="rtl" lang="ar"><div id="jasr-site" dir="rtl" lang="ar">
<a class="skip" href="#main">{copy.text001}</a>{!site.launchReady && <div class="preview-note">{copy.text002}</div>}
<header class="header"><div class="container header-inner"><a aria-label={copy.text040} class="brand" href="#home"><img alt={copy.text041} data-brand-image="" height="103" src={assetUrl(site.logo)} width="120"/><div><b>{site.shortName}</b><small>{site.brandSubtitle}</small></div></a><nav aria-label={copy.text042} class="desktop-nav">{navItems.map(item => <a href={"#"+item.target}>{item.label}</a>)}</nav><img alt={copy.text043} class="vision" data-vision-image="" height="80" hidden={!site.showVision} src={assetUrl(site.visionLogo)} width="120"/><button aria-haspopup="dialog" aria-label={copy.text044} class="iconbtn menu-trigger" id="menu-open"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"></path></svg></button></div></header>
<main id="main"><div class="ribbon" id="home"><div class="ribbon-info"><span id="today">{copy.text007}</span><span>{site.banner}</span></div><nav aria-label={copy.text045} class="ribbon-nav">{navItems.map(item => <a href={"#"+item.target}>{item.label}</a>)}</nav></div>
{layout.sections.filter(s => s.enabled).map(config => <SiteSection config={config} />)}






</main>
<footer class="footer"><div class="container footer-inner"><span>{site.name}</span><span>{copy.text034}<span id="year">2026</span></span></div></footer>
<!-- Contact design adapted from Uiverse.io by Gaurang7717 -->
<nav class="contact-dock" aria-label={copy.text051}>
<a class="contact-float call" href={telLink(site.phones[0].international)} aria-label={copy.text052}><span class="sign" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></span><span class="text" aria-hidden="true">{copy.text035}</span></a>
<a class="contact-float whatsapp" data-whatsapp href={waLink()} target="_blank" rel="noopener noreferrer" aria-label={copy.text053}><span class="sign" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/></svg></span><span class="text" aria-hidden="true">{copy.text036}</span></a>
</nav><button aria-label={copy.text054} class="top-btn" hidden="" id="back-top">⌃</button><div class="ticker">{site.welcome}</div>
<dialog aria-label={copy.text055} class="drawer" id="menu"><button aria-label={copy.text056} class="iconbtn drawer-close" id="menu-close">×</button><a class="brand" href="#home"><img alt={copy.text041} data-brand-image="" height="103" src={assetUrl(site.logo)} width="120"/><div><b>{site.shortName}</b><small>{copy.text037}</small></div></a><p class="muted">{site.banner}</p><nav class="drawer-nav">{navItems.map(item => <a href={"#"+item.target}>{item.label}</a>)}</nav><div class="drawer-contact"><a dir="ltr" href={telLink(site.phones[0].international)}>{site.phones[0].display}</a><a dir="ltr" href={'mailto:' + site.email}>{site.email}</a></div><footer>{site.name}</footer></dialog>

<script type="application/json" id="site-runtime" set:html={JSON.stringify({copy,animations,whatsapp:site.whatsapp,layout}).replace(/</g,"\\u003c")}></script>
<script is:inline src="/scripts/site.js"></script>
<script>
 import "../scripts/gsap-entry.js";
</script></div></body></html>