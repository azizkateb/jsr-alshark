---
import {site,copy,theme,layout,waLink,icons} from '../lib/content';
const {sectionId}=Astro.props;
const visible=(id:string)=>layout.sections.some(s=>s.id===id&&s.enabled);
const serviceHref=(service:{icon:string,title:string})=>service.icon==='file'&&visible('cvs')?'#cvs':waLink('أرغب بالاستفسار عن '+service.title);
const arrow='M19 12H5m6-6-6 6 6 6';
---
{sectionId==='steps' && <section class="section premium-section process-editorial" id="steps" data-section="steps" style={`--premium-heading-scale:${theme.headingScale};--process-count:${site.steps.length}`}><div class="editorial-inner"><div class="section-heading" data-premium-reveal><h2>{site.stepsTitle}</h2><p>{site.stepsIntro}</p></div><ol class="steps process-timeline">{site.steps.map((step,i)=><li data-premium-reveal data-premium-delay={Math.min(i*75,300)}><div class="step-top"><b>{step.title}</b><span class="process-number" dir="ltr">{String(i+1).padStart(2,'0')}</span></div><p>{step.description}</p></li>)}</ol></div></section>}
{sectionId==='why' && <section class="section why premium-section why-editorial" id="why" data-section="why" style={`--premium-heading-scale:${theme.headingScale}`}><div class="editorial-inner why-layout"><div class="why-copy" data-premium-reveal><p class="eyebrow">{copy.text009}</p><h2>{site.whyTitle}</h2><p class="why-description">{site.whyIntro}</p><div class="actions"><a class="btn primary" href={visible('contact')?'#contact':waLink()} {...(!visible('contact')?{target:'_blank',rel:'noopener noreferrer'}:{})}><span>{copy.text008}</span><svg class="editorial-arrow" aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}/></svg></a><a class="btn" data-whatsapp href={waLink()} target="_blank" rel="noopener noreferrer">{copy.text006}</a></div></div><ul class="checks editorial-checks">{site.benefits.map((item,i)=><li data-premium-reveal data-premium-delay={Math.min(i*65,260)}><span class="check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8"/></svg></span><span>{item.text}</span></li>)}</ul></div></section>}
{sectionId==='services' && <section class="section premium-section services-editorial" id="services" data-section="services" style={`--premium-heading-scale:${theme.headingScale};--premium-service-columns:${theme.servicesColumns}`}><div class="editorial-inner"><div class="section-heading" data-premium-reveal><h2>{copy.text004}</h2><p>{copy.text010}</p></div><div class="services editorial-services">{site.services.map((service,i)=><article class="service" data-premium-reveal data-premium-delay={Math.min(i*75,300)}><span class="service-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d={icons[service.icon]||icons.file}/></svg></span><div class="service-copy"><h3>{service.title}</h3><p>{service.description}</p></div><a class="service-explore" href={serviceHref(service)} aria-label={'استكشف '+service.title} {...(!serviceHref(service).startsWith('#')?{target:'_blank',rel:'noopener noreferrer'}:{})}><span>استكشف</span><svg class="editorial-arrow" aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}/></svg></a></article>)}</div></div></section>}
