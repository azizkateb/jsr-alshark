---
import {site, profiles, news, waLink, formatDate, icons, theme, layout, copy, animations, navItems} from '../lib/content';
import {assetUrl,webUrl,telLink} from '../lib/urls';
import {mapEmbedUrl} from '../lib/map.js';
import AboutSection from './AboutSection.astro';
import PremiumSections from './PremiumSections.astro';
import CVSections from './CVSections.astro';
import ContactSection from './ContactSection.astro';
const {config} = Astro.props;
---
{config.id === "hero" && (<>
<section class="container office-hero" aria-label={copy.text046} data-section="hero" id="hero"><figure><img src={assetUrl(site.heroImage)} alt={site.heroAlt} width="440" height="240" fetchpriority="high" decoding="async"/>{site.heroCaption && <figcaption>{site.heroCaption}</figcaption>}</figure></section>
</>)}
{config.id === "about" && <AboutSection />}
{['steps','why','services'].includes(config.id) && <PremiumSections sectionId={config.id} />}
{['cvs','cta'].includes(config.id) && <CVSections sectionId={config.id} />}
{config.id === "news" && (<>
<section class="container section news" id="news" hidden={news.length === 0} aria-label={copy.text047} data-section="news">{news.length > 0 && <><div class="section-heading"><h2>{copy.text057} {site.shortName}</h2></div><div class="news-grid">{news.map((article, index) => <article class="news-card"><button class="news-card-trigger" type="button" aria-haspopup="dialog" aria-controls={`news-dialog-${index}`}><div class="news-card-media">{article.image ? <img src={assetUrl(article.image)} alt={article.title} loading="lazy" decoding="async"/> : <span class="news-card-placeholder" aria-hidden="true">جسر الشرق</span>}</div><div class="news-card-content"><div class="news-card-meta"><time datetime={article.date}>{formatDate(article.date)}</time><span>قراءة الخبر</span></div><h3>{article.title}</h3><p class="news-card-excerpt">{article.body}</p><span class="news-card-read" aria-hidden="true">فتح الخبر <svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></div></button><dialog class="news-dialog" id={`news-dialog-${index}`} aria-labelledby={`news-dialog-title-${index}`}><div class="news-dialog-panel"><button class="news-dialog-close" type="button" aria-label="إغلاق الخبر">×</button>{article.image && <img class="news-dialog-image" src={assetUrl(article.image)} alt={article.title} loading="lazy" decoding="async"/>}<div class="news-dialog-content"><div class="news-card-meta"><time datetime={article.date}>{formatDate(article.date)}</time><span>خبر من جسر الشرق</span></div><h3 id={`news-dialog-title-${index}`}>{article.title}</h3><p>{article.body}</p></div></div></dialog></article>)}</div></>}</section>
</>)}
<script>
  const newsTriggers = document.querySelectorAll('[aria-controls^="news-dialog-"]');
  newsTriggers.forEach((trigger) => {
    const dialog = document.getElementById(trigger.getAttribute('aria-controls') || '');
    if (!(dialog instanceof HTMLDialogElement)) return;
    const close = dialog.querySelector('.news-dialog-close');
    let opener = null;
    trigger.addEventListener('click', () => {
      opener = trigger;
      dialog.showModal();
    });
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  });
</script>
{config.id === "contact" && <ContactSection />}
