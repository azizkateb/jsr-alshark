---
import {site, profiles, news, waLink, formatDate, icons, theme, layout, copy, animations, navItems} from '../lib/content';
import {assetUrl,webUrl,telLink} from '../lib/urls';
import {mapEmbedUrl} from '../lib/map.js';
import AboutSection from './AboutSection.astro';
import PremiumSections from './PremiumSections.astro';
import CVSections from './CVSections.astro';
import ContactSection from './ContactSection.astro';
const {config} = Astro.props;
---
{config.id === "hero" && (<>
<section class="container office-hero" aria-label={copy.text046} data-section="hero" id="hero"><figure><img src={assetUrl(site.heroImage)} alt={site.heroAlt} width="440" height="240" fetchpriority="high" decoding="async"/>{site.heroCaption && <figcaption>{site.heroCaption}</figcaption>}</figure></section>
</>)}
{config.id === "about" && <AboutSection />}
{['steps','why','services'].includes(config.id) && <PremiumSections sectionId={config.id} />}
{['cvs','cta'].includes(config.id) && <CVSections sectionId={config.id} />}
{config.id === "news" && (<>
<section class="container section news" id="news" hidden={news.length === 0} aria-label={copy.text047} data-section="news">{news.length > 0 && <><div class="section-heading"><h2>{copy.text057} {site.shortName}</h2></div><div class="news-grid">{news.map(article => <article class="news-card"><div class="news-card-media">{article.image ? <img src={assetUrl(article.image)} alt={article.title} loading="lazy" decoding="async"/> : <span class="news-card-placeholder" aria-hidden="true">جسر الشرق</span>}</div><div class="news-card-content"><div class="news-card-meta"><time datetime={article.date}>{formatDate(article.date)}</time><span aria-hidden="true">خبر</span></div><h3>{article.title}</h3><p>{article.body}</p></div></article>)}</div></>}</section>
</>)}
{config.id === "contact" && <ContactSection />}
