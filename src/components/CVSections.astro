---
import {site,profiles,copy,theme,waLink} from '../lib/content';
import {assetUrl} from '../lib/urls';
import {CV_ARROW,CV_DOCUMENT,CV_WHATSAPP,cvHeadingParts} from '../lib/cv-visuals.js';
const {sectionId}=Astro.props;
const title=cvHeadingParts(copy.text011);
---
{sectionId==='cvs' && <section class="section cv-editorial" id="cvs" data-section="cvs" style={`--cv-heading-scale:${theme.headingScale}`}><div class="cv-inner"><div class="section-heading"><h2>{title.main}{title.accent && <span class="cv-heading-accent">{title.accent}</span>}</h2><p>{copy.text012}</p></div><div class="countries">{site.countries.map(country=><a class="country" href={waLink(copy.countryPrefix+' '+country.name)} target="_blank" rel="noopener noreferrer"><span class="flag" aria-hidden="true"><img src={assetUrl(country.flagImage)} alt="" width="60" height="60" loading="lazy" decoding="async"/></span><span>{country.name}</span></a>)}</div><p class="availability">{copy.text013}</p><div class:list={['cv-area',{'cv-empty':profiles.length===0}]}>{profiles.length===0 ? <><div class="cv-empty-copy"><h3>{copy.text014}</h3><p>{copy.text015}</p></div><div class="cv-empty-action"><a class="btn cv-enquiry" data-whatsapp href={waLink()} target="_blank" rel="noopener noreferrer"><Fragment set:html={CV_WHATSAPP}/><span>{copy.text016}</span><svg class="cv-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={CV_ARROW}/></svg></a><Fragment set:html={CV_DOCUMENT}/></div></> : <><h3>{copy.text014}</h3>{profiles.map(profile=><article class="cv-row"><div><h3>{profile.title}</h3><p>{profile.country}{profile.description?' · '+profile.description:''}</p><p>{copy.text058} {profile.reference}</p></div><div class="actions"><a class="btn" href={assetUrl(profile.file)} target="_blank" rel="noopener noreferrer">{copy.text017}</a><a class="btn" href={assetUrl(profile.file)} download>{copy.text018}</a><a class="btn primary" href={waLink(copy.profilePrefix+' '+profile.title+' ('+copy.profileRef+': '+profile.reference+')')} target="_blank" rel="noopener noreferrer">{copy.text019}</a></div></article>)}</>}</div></div></section>}
{sectionId==='cta' && <section class="callout cta-editorial" data-section="cta" id="cta" style={`--cv-heading-scale:${theme.headingScale}`}><div class="container cta-banner"><h2>{site.ctaTitle}</h2><p>{site.ctaText}</p><div class="actions"><a class="btn primary" href="#contact"><span>{copy.text008}</span><svg class="cta-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d={CV_ARROW}/></svg></a><a class="btn" href="#cvs">{copy.text020}</a></div></div></section>}
